# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.ts text eol=lf encoding=utf-8
*.tsx text eol=lf encoding=utf-8
*.js text eol=lf encoding=utf-8
*.jsx text eol=lf encoding=utf-8
*.json text eol=lf encoding=utf-8
*.md text eol=lf encoding=utf-8
*.css text eol=lf encoding=utf-8
*.html text eol=lf encoding=utf-8
*.yml text eol=lf encoding=utf-8
*.yaml text eol=lf encoding=utf encoding=utf-8

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Package files
package-lock.json text eol=lf encoding=utf-8
yarn.lock text eol=lf encoding=utf-8

