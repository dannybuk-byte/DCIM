{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCIM DART v0.9 Tasks",
  "type": "object",
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "depends_on",
          "acceptance_ids",
          "mode",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{2}$"
            }
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]{2}$"
            }
          },
          "mode": {
            "enum": [
              "AUDIT",
              "RESEARCH",
              "WRITE",
              "VERIFY",
              "REVIEW"
            ]
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "BLOCKED",
              "IN_PROGRESS",
              "FROZEN",
              "COMPLETE"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
